{
  // The serverless functions under api/ could not simply be added to
  // tsconfig.json's `include`: that config is built for the browser bundle and
  // pins `"types": ["vite/client"]`, which excludes Node's globals entirely, so
  // every `process.env` in api/ would fail to resolve. These files run on Node,
  // not in a browser, so they get their own config instead.
  //
  // Checked by `npm run lint` alongside the client. Before this existed, nothing
  // under api/ was typechecked at all, including the billing webhook, checkout,
  // and account deletion.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    // NodeNext, not bundler. Nothing bundles these files: Vercel compiles each
    // one and Node loads the result directly, and because package.json sets
    // "type": "module" that result is ESM, where a relative import must carry
    // its file extension.
    //
    // "bundler" accepts extensionless relative imports, so `./_auth` typechecked
    // cleanly, built cleanly, and then failed at runtime with ERR_MODULE_NOT_FOUND
    // on every request. Every billing and account-deletion endpoint was down in
    // production while the lint stayed green, because the lint was describing a
    // bundler that does not exist in this path.
    //
    // NodeNext makes the typecheck model the loader that actually runs, so a
    // missing extension is now a compile error rather than a 500.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["api"]
}
