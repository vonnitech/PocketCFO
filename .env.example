# ── Supabase ────────────────────────────────────────────────────────────────
# Copy from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Native Android/iOS builds: deployed HTTPS site hosting /api/delete-account.
# Set in .env.native.local. Public URL only; never put a service-role key here.
VITE_NATIVE_API_ORIGIN=https://your-deployed-site.example

# Server-only. Required for account deletion and billing endpoints.
# Never prefix this with VITE_ and never expose it in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Canonical public web origin. Server-only.
APP_ORIGIN=https://your-deployed-site.example

# Paddle billing (new subscribers). 'sandbox' for testing, 'production' for real
# payments; anything else is treated as sandbox. Every Paddle value below is
# specific to one environment, so switch them all together.
PADDLE_ENV=sandbox
PADDLE_API_KEY=your-paddle-api-key-here
PADDLE_WEBHOOK_SECRET=your-paddle-notification-secret-here
PADDLE_PRICE_MONTHLY=pri_your-monthly-price-id
PADDLE_PRICE_ANNUAL=pri_your-annual-price-id
# Browser side. The client-side token is public by design.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token

# LemonSqueezy: only for accounts that subscribed before the switch to Paddle
# (their webhook, billing portal and account-deletion cancellation).
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key-here
LEMONSQUEEZY_WEBHOOK_SECRET=your-random-signing-secret-here
LEMONSQUEEZY_STORE_ID=your-store-id-here
LEMONSQUEEZY_VARIANT_MONTHLY=your-monthly-variant-id
LEMONSQUEEZY_VARIANT_ANNUAL=your-annual-variant-id
LEMONSQUEEZY_VARIANT_LIFETIME=your-lifetime-variant-id

# ── PostHog (product funnel) ────────────────────────────────────────────────
# Optional. Leave unset and analytics stays off entirely: events go to the
# console in development and nowhere else. Copy the Project API key from:
# PostHog → Settings → Project → Project API key. This key is public by design.
# Host defaults to US cloud. Set it to https://eu.i.posthog.com for an EU
# project. A key sent to the wrong region records nothing and fails quietly.
VITE_POSTHOG_KEY=phc_your-project-api-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com
